<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ea4k.klog</id>

  <name>KLog</name>
  <summary>Amateur radio logging program</summary>

  <metadata_license>CC0-1.0</metadata_license>  <!-- FSFAP is unusual; CC0-1.0 is standard -->
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.ea4k">
    <name>Jaime Robles (EA4K)</name>
  </developer>

  <description>
        <p>KLog is a multiplatform free software that runs in GNU/Linux, macOS and Windows. KLog provides general purpose Hamradio DX logging support.</p>
  </description>

  <!-- desktop-id must match the actual .desktop filename -->
  <launchable type="desktop-id">io.github.ea4k.klog.desktop</launchable>

  <url type="homepage">https://github.com/ea4k/klog</url> 
  <url type="bugtracker">https://github.com/ea4k/klog/issues</url>
  <url type="vcs-browser">https://github.com/ea4k/klog</url>

  <content_rating type="oars-1.1" />

  <categories>
    <category>Utility</category>
    <category>HamRadio</category>
  </categories>

<keywords>
    <keyword>hamradio</keyword>
    <keyword>ham</keyword>
    <keyword>amateur radio</keyword>
    <keyword>logger</keyword>
    <keyword>logbook</keyword>
    <keyword>adif</keyword>
    <keyword>qsl</keyword>
    <keyword>dxcc</keyword>
    <keyword>qso</keyword>
    <keyword>dx</keyword>
    
    <keyword xml:lang="es">radioaficion</keyword>
    <keyword xml:lang="es">radioaficionado</keyword>
    <keyword xml:lang="es">libro de guardia</keyword>
    <keyword xml:lang="es">registro</keyword>
    <keyword xml:lang="es">contactos</keyword>
  </keywords>
    <screenshots>
    <screenshot type="default">
      <caption>KLog main window showing the QSO entry and log view</caption>
      <image>https://user-images.githubusercontent.com/29511627/103910279-f1009b80-5104-11eb-9b30-83e436528c56.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <!-- must match actual package version -->
    <release version="@APP_PKGVERSION@" date="@KLOG_BUILD_DATE@">
      <description>
        <p>New Release.</p>
      </description>
    </release>
  </releases>
</component>
